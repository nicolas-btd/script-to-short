# ==============================================================================
# script-to-short - Configuration
# ==============================================================================

# 1. Google Gemini API Key (REQUIRED)
# Get your free key at:
# https://aistudio.google.com/ (click "Get API key" -> "Create API key")
GEMINI_API_KEY="your_api_key_here"

# 2. Default Voice (OPTIONAL)
# Available voices: Puck, Charon, Kore, Fenrir, Aoede
# - Puck   : Energetic masculine, punchy (ideal for cartoons, explainers, TikTok)
# - Charon : Deep, solemn masculine (documentaries, history, horror)
# - Kore   : Warm, calm, clear feminine (health, science, narrative)
# - Fenrir : Raspy, commanding masculine (action, fitness, trailers)
# - Aoede  : Elegant, soft, expressive feminine (lifestyle, culture, education)
GEMINI_VOICE="Puck"

# 3. Gemini Models (OPTIONAL)
GEMINI_TTS_MODEL="gemini-2.5-flash"
GEMINI_PLANNER_MODEL="gemini-2.5-flash"
